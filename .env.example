# Copy this file to .env and fill in your endpoint.

# If you run everything INSIDE the Colab notebook, leave as localhost.
# If you tunnel out (ngrok) to reach Colab from your Mac, paste the public URL here
# (no trailing slash), e.g. https://abcd-1234.ngrok-free.app
XINFERENCE_ENDPOINT=http://localhost:9997

# Model identifiers — must match what you launch in the notebook.
LLM_MODEL=qwen2.5-instruct
EMBED_MODEL=bge-base-en-v1.5
RERANK_MODEL=bge-reranker-base
